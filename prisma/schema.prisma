generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// AUTH
// (Kept from the template you started from — this part is genuinely
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  COUNSELOR // staff assigned to guide an applicant through a submission
  USER
}

model User {
  id                 String    @id @default(uuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  role               UserRole  @default(USER)
  isTwoFactorEnabled Boolean   @default(false)

  // Counselors only: a short introduction shown to the applicants they look after
  bio String?
    // Counselors only: a front desk counselor is given every new account first. They read the profile
  // and pass the applicant on to the right counselor. Front desk counselors take turns.
  isFrontDesk Boolean @default(false)
  // Counselors only: false while disabled or on leave. The rota skips them, and an admin cannot
  // pick them for an applicant. Applicants they already look after stay with them.
  isActive Boolean @default(true)
  // Applicants: the counselor looking after this user. Set automatically when the account
  // is created (the counselor on duty that week) and changeable by an admin at any time.
  counselorId String?
  counselor   User?   @relation("UserCounselor", fields: [counselorId], references: [id], onDelete: SetNull)
  // Counselors: the applicants assigned to them
  clients     User[]  @relation("UserCounselor")
  // Counselors: the weeks they are on duty
  dutyWeeks   CounselorDuty[]

  accounts              Account[]
  twoFactorConfirmation TwoFactorConfirmation?

  // Submissions this user (as an applicant) owns.
  submissions           ApplicationSubmission[] @relation("UserSubmissions")
  // Submissions this user (as staff) has been assigned to counsel.
  counseledSubmissions  ApplicationSubmission[] @relation("CounseledSubmissions")

  // The saved answers of this user's eligibility checks (one per kind: study abroad, visa...).
  eligibilityProfiles   EligibilityProfile[]

  // Conversations where this user is the client (support/enquiry chats).
  clientConversations Conversation[] @relation("ConversationClient")
  // Conversations an admin/counselor has joined or picked up — a chat can
  // have more than one staff member on it, and any admin/counselor can
  // join at any time.
  staffConversations  Conversation[] @relation("ConversationStaff")
  messagesSent        Message[]      @relation("MessageSender")
  blogPosts           BlogPost[]     @relation("BlogPostAuthor")

  // Journey: the document checks and stage sign offs this user (as staff) has made.
  reviewedTasks   SubmissionTask[]  @relation("TaskReviewer")
  completedStages SubmissionStage[] @relation("StageCompleter")

  // Profile details collected during onboarding and edited on the profile page
  profile        UserProfile?
  qualifications AcademicQualification[]
  tests          UserTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([counselorId])
}

// Which counselor is on duty for a week. A new account is assigned the counselor on duty
// that week. Duty weeks run Monday to Sunday in Nigerian time, and weekStart is the
// Monday 00:00 of the week. A week with no row keeps the counselor of the last week that
// has one, so someone is always on duty; the admin only adds a row to change it.
model CounselorDuty {
  id          String   @id @default(uuid())
  counselorId String
  weekStart   DateTime @unique

  counselor User @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([counselorId])
}

// Where the counselor rota has reached. One row, id "main". counselorId is the counselor whose
// turn it is: the next new account goes to them, or to the next active one if they are disabled.
model CounselorRotation {
  id          String   @id
  counselorId String?
  updatedAt   DateTime @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorConfirmation {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────
// PORTAL — ADMIN-MANAGED TERMINALS
// The 5 terminals (Exams & Prep, Work & Migration, Study Abroad,
// Scholarships, Free Courses) are just rows here, not a hardcoded enum —
// the admin block manages them directly, so adding a 6th one later
// (e.g. a dedicated "Property" or "Money Exchange" terminal) needs no
// schema change.
//
// What a terminal is USED FOR is the one thing that is an enum (PortalKind). It is chosen
// when the terminal is created, so the website knows where and how to use it: the
// "Proceed to apply" buttons on schools and institutions open the SCHOOL terminal, a visa
// page would open the VISA one, and so on. New terminals of an existing kind need no
// schema change. A brand new kind needs one line here plus the code that uses it.
// ─────────────────────────────────────────────────────────────────────────

enum PortalKind {
  GENERAL // not tied to a flow on the website, shown on the portal only
  SCHOOL // applications opened from the school and institution pages
  VISA
  WORK_ABROAD
  HOUSING
  EVENT // events and fairs, collects visitor data
  ELIGIBILITY // the eligibility check questions (/portal/eligibility-check), never listed as an application
}

model PortalTerminal {
  id       String     @id @default(uuid())
  name     String     @unique // "Exams & Prep"
  slug     String     @unique // "exams-prep"
  icon     String?
  kind     PortalKind @default(GENERAL) // where and how this terminal is used
  order    Int        @default(0)
  isActive Boolean    @default(true)
  // false = still works (links, school "Proceed to apply" flow) but no card on /portal
  isVisible Boolean    @default(true)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────────────────
// FIELD LIBRARY
// Every possible input a form could ever ask for — personal-data fields
// (family name, DOB, passport number...) sit in the same catalog as
// travel/property/exchange-specific ones (preferred country, property
// budget, currency amount, passport photo...). Nothing about "personal
// details" is special-cased in its own model anymore — it's just a group
// of FieldDefinitions like any other, which is what lets the admin select
// and unselect exactly what a given application needs.
// ─────────────────────────────────────────────────────────────────────────

enum FieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  IMAGE // e.g. passport photo
  FILE // e.g. passport bio page, proof of funds, transcripts
}

// How a SELECT / MULTI_SELECT is drawn.
enum FieldDisplay {
  DEFAULT // a dropdown (what every existing field uses)
  PILLS // every choice as a tap-able pill, like "Foundation / Undergraduate / Postgraduate"
  SEARCH // a search box over a long list (majors, universities), with `suggestions` as chips
  CARDS // every choice as a card with a short plain-words explanation under it (visa purposes, visa types)
}

// Where the choices of a SELECT / MULTI_SELECT come from.
enum OptionsSource {
  STATIC // the list typed in `options`
  COUNTRIES // the Country table
  UNIVERSITIES // the University table, filtered by the country picked in `dependsOnKey`
  DESTINATIONS // the Destination table: the countries people move to
  CITIES // the City table, filtered by the destination picked in `dependsOnKey`
  VISA_PURPOSES // the VisaPurpose table: "What do you want to do abroad?"
  VISA_TYPES // the VisaType table: destination in `dependsOnKey`, purpose in `alsoDependsOnKey`
}

model FieldDefinition {
  id          String    @id @default(uuid())
  key         String    @unique // "family_name", "passport_number", "property_budget"
  label       String // "Family name / surname (exactly as in passport)"
  type        FieldType
  category    String    @default("General") // groups the library in the admin UI — "Personal Details", "Academic Background"...
  placeholder String?
  helpText    String?
  options     Json? // choices for SELECT/MULTI_SELECT, e.g. ["Mr","Mrs","Ms","Dr"]

  // How a SELECT / MULTI_SELECT is drawn and where its choices come from. The defaults keep every
  // existing field exactly as it is today (a dropdown with the choices typed in `options`).
  display       FieldDisplay  @default(DEFAULT)
  optionsSource OptionsSource @default(STATIC)
  // Only for a source that depends on an earlier answer: the `key` of that field. Example: the
  // university field has optionsSource UNIVERSITIES and dependsOnKey "education_country", so it
  // lists the universities of the country picked there.
  dependsOnKey  String?
  // A second earlier answer the list depends on. Only VISA_TYPES uses it: the destination is in
  // `dependsOnKey` and the purpose the person picked is here.
  alsoDependsOnKey String?
  // SELECT only: add an "Other" choice at the end of the list. Picking it opens a text box and what
  // the person types is saved as the answer (a city that is not in the list). A list that comes back
  // empty (a destination with no cities yet) shows the text box straight away.
  allowOther    Boolean       @default(false)
  otherLabel    String? // wording of that choice, "Other" when empty
  // MULTI_SELECT only: how many choices may be picked ("pick up to 5 subjects"). Null = no limit.
  maxSelections Int?
  // Shown as quick-pick chips under a search box ("Popular searches"). Same shape as `options`.
  suggestions   Json?

  // Optional validation, enforced server-side when a value is saved.
  minLength Int?
  maxLength Int?
  pattern   String? // regex, e.g. for passport number formats

  applicationFields ApplicationField[]
  // Journey: the details inputs of document tasks that use this field.
  taskFields        ApplicationTaskField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// APPLICATIONS (admin-created, one per terminal)
// This is what the admin creates under a terminal — "IELTS Academic",
// "Work in Germany", "Study at XYZ University", "Buy Property — Lekki
// Gardens", "USD/NGN Exchange". Which inputs it asks for is entirely
// driven by which FieldDefinitions get attached via ApplicationField, so
// a brand-new kind of application (money exchange, property purchase...)
// is just new rows, never a schema change.
// ─────────────────────────────────────────────────────────────────────────

model Application {
  id         String     @id @default(uuid())
  terminalId String
  // Copy of the terminal's kind, kept in sync by the admin actions (never edited by hand),
  // so an application can be found by what it is for without joining its terminal.
  kind       PortalKind @default(GENERAL)
  name       String // "Work in Germany"
  subtitle   String? // "One team, 14 countries..."
  slug       String
  icon       String?
  badge      String? // "14 countries open"
  isLive     Boolean @default(false) // the small green dot shown on IELTS in the mock
  order      Int     @default(0)
  isActive   Boolean @default(true)

  terminal    PortalTerminal          @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  tags        ApplicationTag[]
  fields      ApplicationField[]
  steps       ApplicationStep[]
  // Journey (the timeline engine): empty = the application is the classic step form.
  stages      ApplicationStage[]
  tasks       ApplicationTask[]
  submissions ApplicationSubmission[]

  eligibilityProfiles EligibilityProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([terminalId, slug])
  @@index([terminalId])
  @@index([kind])
}

// Small pills shown on an application card — country flags under "Work in
// Europe" (Poland, Germany...), exam variants under "IELTS", etc.
model ApplicationTag {
  id            String  @id @default(uuid())
  applicationId String
  label         String
  icon          String?
  order         Int     @default(0)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Join table: which FieldDefinitions belong to THIS Application, in what
// order, on which wizard step, and whether they're required here — the
// same "passport number" field can be required on one application and
// absent entirely from another.
model ApplicationField {
  id                String  @id @default(uuid())
  applicationId     String
  fieldDefinitionId String
  isRequired        Boolean @default(false)
  stepNumber        Int     @default(1) // which step of the wizard this field appears on
  order             Int     @default(0) // position within that step

  // Show this field only when an earlier answer matches. Null = always shown. Shape:
  //   { "fieldKey": "study_level", "in": ["Postgraduate", "Doctorate"] }
  // A step whose fields are all hidden is skipped. Hidden fields are never required.
  showWhen          Json?

  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition   @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  values          SubmissionValue[]

  @@unique([applicationId, fieldDefinitionId])
  @@index([applicationId])
  @@index([fieldDefinitionId])
}

// The heading of one step of an application ("What do you wish to study?"). Optional: a step
// without a row here keeps the old behaviour and is titled with the category of its first field.
model ApplicationStep {
  id            String  @id @default(uuid())
  applicationId String
  stepNumber    Int
  title         String
  emoji         String? // shown after the title, e.g. "📚"

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, stepNumber])
  @@index([applicationId])
}

// ─────────────────────────────────────────────────────────────────────────
// SUBMISSIONS
// One applicant's actual attempt at an Application. Total step count and
// per-step completion are derived from ApplicationField + SubmissionValue
// at query time (max stepNumber, and which required fields have a value)
// rather than stored, so they are always computed server-side and never
// trusted or cached.
// ─────────────────────────────────────────────────────────────────────────

enum SubmissionStatus {
  DRAFT // started, not yet submitted — "nothing is created until you save"
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

model ApplicationSubmission {
  id            String @id @default(uuid())
  userId        String
  applicationId String

  status      SubmissionStatus @default(DRAFT)
  currentStep Int              @default(1)
  submittedAt DateTime?

  // "Has someone at Mafit already been helping you?" — typed before being
  // matched to a real counselor account; counselorId is set once matched.
  counselorRequestName String?
  counselorId          String?

  // WHO the application is for (school and institution applications, kind SCHOOL).
  // All schools and institutions share one application, so this is what tells the
  // submissions apart. All null for every other kind of application.
  institutionId       String?
  institutionCourseId String?
  schoolId            String?
  schoolCourseId      String?
  // names as they were when the student applied, so the admin still sees what the
  // application was for if the school or course is later renamed or deleted
  targetName       String?
  targetCourseName String?

  user        User        @relation("UserSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  counselor   User?       @relation("CounseledSubmissions", fields: [counselorId], references: [id], onDelete: SetNull)

  institution       Institution?       @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  institutionCourse InstitutionCourse? @relation(fields: [institutionCourseId], references: [id], onDelete: SetNull)
  school            School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolCourse      SchoolCourse?      @relation(fields: [schoolCourseId], references: [id], onDelete: SetNull)

  values   SubmissionValue[]
  versions SubmissionVersion[]
  // Journey: this applicant's progress on the timeline.
  taskEntries  SubmissionTask[]
  stageEntries SubmissionStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([applicationId])
  @@index([userId, applicationId])
  @@index([institutionId])
  @@index([schoolId])
  @@index([status])
}

// A frozen copy of ALL the answers, taken every time the student presses Save & Submit
// (and Save & Resubmit). A submitted application stays editable, so the live answers
// can change after it was sent; the versions keep what was sent each time, which is
// what the admin looks back at ("view previous answers"). Never edited, only added.
model SubmissionVersion {
  id           String @id @default(uuid())
  submissionId String
  version      Int // 1 for the first submit, 2 for the next, and so on

  // [{ applicationFieldId, label, type, stepNumber, order, value, fileUrl }]
  // The label is copied so the version still reads well if the field is renamed later.
  answers Json

  submission ApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([submissionId, version])
  @@index([submissionId])
}

// The actual answer to one ApplicationField, for one submission.
// Text/number/date/select answers go in `value` (stringified); IMAGE/FILE
// fields use `fileUrl` instead (store a JSON array there if an image field
// is ever configured to accept more than one file — no schema change
// needed for that later).
model SubmissionValue {
  id                 String @id @default(uuid())
  submissionId       String
  applicationFieldId String

  value   String? @db.Text
  fileUrl String?

  submission       ApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  applicationField ApplicationField      @relation(fields: [applicationFieldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, applicationFieldId])
  @@index([submissionId])
}

// ─────────────────────────────────────────────────────────────────────────
// JOURNEY (the application engine)
// An application with stages is shown to the applicant as a timeline instead of a step form:
//   Submit Documents > Apply > Offer > Confirm enrolment > Visa > Enroll
// A stage is a list of tasks. A task is something the applicant uploads (DOCUMENT: files plus the
// details of the document), fills in (FORM: details only) or something staff tick off (MILESTONE).
// A stage stays locked until the stage before it is complete. A stage is complete either as soon
// as the applicant has done every required task (AUTO) or when a counsellor signs it off (STAFF),
// which is how "consultation first" is enforced.
// All of it is rows, so the same engine runs school applications, visas, accommodation and any
// terminal added later: new stages and tasks are seed data (prisma/seed-journey.ts), never code.
// The details inputs reuse the field library (FieldDefinition), exactly like the eligibility check.
// An application with no stages keeps using the classic wizard, so nothing existing changes.
// ─────────────────────────────────────────────────────────────────────────

enum TaskKind {
  DOCUMENT // files plus the details of the document (passport: scan + passport number)
  FORM // details only, no file (personal statement typed in, a question)
  MILESTONE // done by staff, the applicant only watches (application sent to the school, offer received)
}

enum StageCompletion {
  AUTO // complete once every required task is submitted
  STAFF // complete only when a counsellor signs it off
}

enum TaskStatus {
  DRAFT // saved, not yet sent
  SUBMITTED // sent, waiting for a counsellor
  VERIFIED // checked by a counsellor (locks the task)
  CHANGES_REQUESTED // sent back with a note
}

model ApplicationStage {
  id            String          @id @default(uuid())
  applicationId String
  stageNumber   Int // 1, 2, 3 ... the order on the timeline
  slug          String // "submit-documents"
  title         String // "Submit Documents"
  description   String? // one line shown under the stage heading
  completion    StageCompletion @default(AUTO)

  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tasks            ApplicationTask[]
  submissionStages SubmissionStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, stageNumber])
  @@unique([applicationId, slug])
  @@index([applicationId])
}

model ApplicationTask {
  id            String   @id @default(uuid())
  applicationId String // copy of the stage's application, so a task link only needs the application
  stageId       String
  slug          String // "passport": unique inside the application, used in the task address
  groupTitle    String? // heading on the stage page: "Identity", "Academic Certificates"
  subgroupTitle String? // smaller heading under it: "Senior high school", "Undergraduate"
  title         String // "Passport"
  description   String? // shown on the task page
  kind          TaskKind @default(DOCUMENT)
  isRequired    Boolean  @default(true)
  order         Int      @default(0)
  maxFiles      Int      @default(10) // pages of a document (one passport, several marksheet pages)
  accept        String? // file picker filter, "image/*,application/pdf". Empty = images and PDF
  // Show the task only when an earlier answer matches (the same rule shape as ApplicationField.showWhen):
  //   { "fieldKey": "study_level", "in": ["Postgraduate", "Doctorate"] }
  // The answers it reads are the applicant's eligibility check answers and the chosen course.
  showWhen      Json?
  // Prefill of the details: which qualification of the applicant's profile this document belongs to
  // ("Bachelor's degree" for the undergraduate certificate).
  qualificationLevel String?

  application     Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage           ApplicationStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  fields          ApplicationTaskField[]
  submissionTasks SubmissionTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, slug])
  @@index([stageId])
  @@index([applicationId])
}

// The details inputs of one task ("Fill in your details" beside the document).
model ApplicationTaskField {
  id                String  @id @default(uuid())
  taskId            String
  fieldDefinitionId String
  isRequired        Boolean @default(false)
  order             Int     @default(0)
  showWhen          Json? // same shape as ApplicationField.showWhen, reads answers of this task

  task            ApplicationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([taskId, fieldDefinitionId])
  @@index([taskId])
  @@index([fieldDefinitionId])
}

// One applicant's work on one task. Created the first time they save it.
model SubmissionTask {
  id           String     @id @default(uuid())
  submissionId String
  taskId       String
  status       TaskStatus @default(DRAFT)

  // The details, one flat { fieldKey: value } object (a multi-select is joined with commas).
  answers      Json       @default("{}")

  // Written by staff: why changes are needed, and a short line the applicant sees on the task card
  // ("Scores meet criteria").
  reviewNote   String?    @db.Text
  badge        String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?

  submission ApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  task       ApplicationTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewedBy User?                 @relation("TaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  files      SubmissionTaskFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, taskId])
  @@index([submissionId])
  @@index([status])
}

// One page of an uploaded document.
model SubmissionTaskFile {
  id               String  @id @default(uuid())
  submissionTaskId String
  url              String
  name             String
  mimeType         String?
  size             Int?
  order            Int     @default(0)

  submissionTask SubmissionTask @relation(fields: [submissionTaskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([submissionTaskId])
}

// A staff sign off of one stage of one submission. Only STAFF stages need a row; an AUTO stage is
// complete by what the applicant has done. Removing completedAt reopens the stage.
model SubmissionStage {
  id            String    @id @default(uuid())
  submissionId  String
  stageId       String
  completedAt   DateTime?
  completedById String?
  note          String?   @db.Text

  submission  ApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  stage       ApplicationStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  completedBy User?                 @relation("StageCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, stageId])
  @@index([submissionId])
}

// ─────────────────────────────────────────────────────────────────────────
// MESSAGING — a support/enquiry chat between one client and whichever
// admin(s)/counselor(s) handle it. One fixed client per conversation;
// staff is a many-to-many so any admin or counselor can pick up, join, or
// hand off the same conversation at any time — nothing about "who's
// assigned" is locked in at creation. submissionId optionally ties the
// chat to the ApplicationSubmission it's about, since a lot of these
// conversations will start from an applicant's in-progress submission.
// ─────────────────────────────────────────────────────────────────────────

enum ConversationStatus {
  OPEN
  CLOSED
}

model Conversation {
  id           String             @id @default(uuid())
  clientId     String
  submissionId String? // optional link to the ApplicationSubmission this chat is about
  subject      String? // short label, e.g. "Question about IELTS submission"
  status       ConversationStatus @default(OPEN)

  client User @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Cascade)
  staff  User[] @relation("ConversationStaff") // admins/counselors who've joined or picked this up

  messages Message[]

  // Set when the client sends a message and nobody on the staff side has answered yet; cleared
  // when staff reply. It is what the "awaiting reply" views read, and the staff email alert is
  // sent when it goes from empty to set, so one waiting turn means one email, not one per message.
  awaitingSince DateTime?

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
  @@index([submissionId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([awaitingSince])
}

model Message {
  id             String  @id @default(uuid())
  conversationId String
  senderId       String
  body           String? @db.Text
  fileUrl        String? // image/document attachment

  seenByIds String[] @default([]) // userIds who've seen this message

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
}

// ─────────────────────────────────────────────────────────────────────────
// BLOG
// coverImage is the required front/hero image shown on cards and at the
// top of a post. content stores the rich-text editor's HTML output.
// BlogPostImage holds any additional images used inside the post body
// (a gallery, or images the editor uploads and references by URL in
// `content`) — kept as its own model rather than a plain String[] so each
// image can carry its own alt text, caption, and ordering.
// ─────────────────────────────────────────────────────────────────────────

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  excerpt         String?
  content         String         @db.Text
  coverImage      String // required front/hero image for the post
  coverImageAlt   String?
  tags            String[]       @default([])
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  views           Int            @default(0)
  metaTitle       String? // optional SEO overrides
  metaDescription String?

  authorId String
  author   User   @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  images BlogPostImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
}

// Additional images used inside a post's body (beyond the single cover
// image above) — e.g. a gallery block, or images inserted through the
// editor's image-upload tool.
model BlogPostImage {
  id         String  @id @default(uuid())
  blogPostId String
  url        String
  altText    String?
  caption    String?
  order      Int     @default(0)

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([blogPostId])
}

// ─────────────────────────────────────────────────────────────────────────
// INSTITUTIONS
// The persisted, admin-managed catalog behind the course-search feature.
// Fields intentionally mirror the flat `School`/`RawSchool` shape the
// Claude-powered search route already returns (src/lib/school-search/*),
// so a row here and a live AI-search result can be rendered by the same
// ResultCard component. imageUrl/logoUrl are resolved the same way the
// search route does it (Wikipedia page-image + Google favicon) rather
// than trusted from free text, since models/admins hallucinate URLs.
// ─────────────────────────────────────────────────────────────────────────

model Institution {
  id   String @id @default(uuid())
  name String
  slug String @unique

  city            String?
  country         String?
  institutionType String? // e.g. "Public research university", "Pathway college (Navitas)"
  summary         String  @db.Text
  programs        String[] @default([]) // up to 3 real programme names

  // English-proficiency requirements
  ieltsOverall      Float?
  ieltsMinBand      Float?
  ieltsAlternatives String[] @default([]) // e.g. ["TOEFL iBT 90", "PTE 65"]
  ieltsNote         String?

  // Tuition
  tuitionMin      Int?
  tuitionMax      Int?
  tuitionCurrency String? // ISO 4217, e.g. GBP, USD, CAD, AUD
  tuitionPeriod   String? // e.g. "per year (2025/26)"
  tuitionNote     String?

  ranking  String? // short ranking string, e.g. "QS #142 (2026)"
  website  String?
  imageUrl String? // campus photo
  logoUrl  String? // favicon/logo

  // ── Institution profile (all optional, filled in over time) ──────────
  // Stat strip
  founded        Int?
  acceptanceRate String? // e.g. "85%"
  upcomingIntake String? // e.g. "Jan 2027"

  // "Highlights" tabs: one short paragraph each. A tab with no text is hidden.
  overview      String? @db.Text
  studentLife   String? @db.Text
  accommodation String? @db.Text
  library       String? @db.Text
  sports        String? @db.Text

  // Social links
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  linkedinUrl  String?
  youtubeUrl   String?

  // SEO overrides for the institution page (fall back to name/summary)
  metaTitle       String?
  metaDescription String?

  courses   InstitutionCourse[]
  campuses  InstitutionCampus[]
  faqs      InstitutionFaq[]
  documents InstitutionDocument[]

  applicationSubmissions ApplicationSubmission[]

  isActive Boolean @default(true)
  // Main partner institutions shown on the course-search page before the
  // visitor runs a search at all (a fixed "our partners" set, not a search
  // result). `order` decides their left-to-right/top-to-bottom position.
  isFeatured Boolean @default(false)
  order      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([isActive])
  @@index([order])
}

// A real, individual course at an institution (the "Courses" tab). The
// institution's `programs` array stays as the short list of subject areas.
model InstitutionCourse {
  id            String  @id @default(uuid())
  institutionId String
  name          String // "Ontario College Graduate Certificate, Cybersecurity Response Planning"
  level         String? // "Undergraduate" | "Postgraduate" (drives the study-level filter)
  degree        String? // "MSc", "BSc", "Diploma", "Graduate Certificate"...
  subject       String? // "Cyber Security" (drives the subject chips)
  duration      String? // "1 Year"
  nextIntake    String? // "Jan 2027"
  intakes       String? // "January, May, September"

  // Fee for the course. Currency falls back to the institution's tuitionCurrency.
  tuitionAmount   Int?
  tuitionCurrency String?
  tuitionPeriod   String? // "per year"

  description String? @db.Text
  order       Int     @default(0)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  applicationSubmissions ApplicationSubmission[]

  createdAt DateTime @default(now())

  @@index([institutionId])
  @@index([level])
  @@index([subject])
}

// A campus of the institution (the "Campuses" tab): a name plus one paragraph.
model InstitutionCampus {
  id            String  @id @default(uuid())
  institutionId String
  name          String // "Brantford"
  city          String?
  address       String?
  description   String? @db.Text
  order         Int     @default(0)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([institutionId])
}

// One question and answer (the "FAQs" tab).
model InstitutionFaq {
  id            String @id @default(uuid())
  institutionId String
  question      String
  answer        String @db.Text
  order         Int    @default(0)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([institutionId])
}

// A document an applicant needs (the "Required Documents" tab), grouped by
// study level and by category (Visa, Financial, Identity, Academic...).
model InstitutionDocument {
  id            String @id @default(uuid())
  institutionId String
  studyLevel    String // "Undergraduate" | "Postgraduate"
  category      String // "Visa" | "Financial" | "Identity" | "Academic"
  name          String // "Passport"
  order         Int    @default(0)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([institutionId])
  @@index([studyLevel])
}

// ─────────────────────────────────────────────────────────────────────────
// SCHOOLS
// The admin-managed schools behind the "Top schools" section on the home
// page and each school's own SEO detail page at /schools/[slug].
// `description` is the short blurb (card + meta-description fallback);
// paragraph1..4 are the short-blog body of the detail page. Courses and
// gallery images are child rows so the admin can add/remove as many as
// needed without a schema change. `country` must match a name in
// COUNTRIES (src/constants/schools.ts) so the country tabs keep working.
// ─────────────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────────────
// REPLACE the three School models in prisma/schema.prisma with this.
//
// What changed vs your current models:
//   School:        + famousFor, tuitionTo, overview, services, accommodation,
//                  locationInfo, highlights, scholarships relation
//                  - paragraph1..4 (replaced by the named sections)
//   SchoolCourse:  + degree
//   SchoolScholarship: new child table
//
// Page sections this feeds (same order as the StudyIn page):
//   stat strip  -> ranking, founded, famousFor, tuitionFrom..tuitionTo
//   Overview    -> overview
//   Services    -> services
//   Rankings    -> highlights (bullet list)
//   Accommodation -> accommodation
//   Location    -> locationInfo
//   Courses     -> courses rows
//   Scholarships-> scholarships rows
//   Photos between sections -> the existing gallery images
// ─────────────────────────────────────────────────────────────────────────

model School {
  id   String @id @default(uuid())
  name String
  slug String @unique

  country String // must match a COUNTRIES name, e.g. "United Kingdom"
  city    String
  founded Int?

  // Stat strip
  ranking    String? // e.g. "QS #29 (2026)"
  famousFor  String? // e.g. "Business, Engineering, Physics"
  acceptanceRate  String? // e.g. "60%+"
  tuitionFrom     Int? // whole units of tuitionCurrency, per year
  tuitionTo       Int? // top of the range; leave empty to show "from" only
  tuitionCurrency String  @default("USD") // ISO 4217: GBP, CAD, USD, EUR, AUD
  website         String?

  // Content
  description String @db.Text // short blurb: school card + meta fallback

  // Detail page sections (each one optional; empty sections are hidden)
  overview      String? @db.Text
  services      String? @db.Text // international student services
  accommodation String? @db.Text
  locationInfo  String? @db.Text // the city / campus location section
  highlights    String[] // "Rankings" bullet list, one item per entry

  // Images
  coverImage    String // card image + hero + og:image fallback
  coverImageAlt String?
  logoUrl       String?

  // SEO overrides (fall back to name/description when empty)
  metaTitle       String?
  metaDescription String?

  isActive Boolean @default(true)
  order    Int     @default(0)

  courses      SchoolCourse[]
  images       SchoolImage[]
  scholarships SchoolScholarship[]

  applicationSubmissions ApplicationSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([isActive])
  @@index([order])
}

model SchoolCourse {
  id          String  @id @default(uuid())
  schoolId    String
  name        String // "Advanced Computer Science"
  degree      String? // "MSc", "BSc", "MBA", "Foundation"...
  level       String? // "Undergraduate", "Postgraduate"...
  duration    String? // "1 year", "3 years"
  tuition     String? // free text, e.g. "£18,500 / year"
  intakes     String? // e.g. "September, January"
  description String? @db.Text
  imageUrl    String?
  order       Int     @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  applicationSubmissions ApplicationSubmission[]

  createdAt DateTime @default(now())

  @@index([schoolId])
}

model SchoolImage {
  id       String  @id @default(uuid())
  schoolId String
  url      String
  altText  String?
  caption  String?
  order    Int     @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([schoolId])
}

model SchoolScholarship {
  id           String  @id @default(uuid())
  schoolId     String
  name         String // "Strathclyde Alumni Scholarship: Postgraduate Taught"
  academicYear String? // "2026" or "2026/27"
  description  String? @db.Text
  url          String? // "Learn more" link
  order        Int     @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([schoolId])
}

// ─────────────────────────────────────────────────────────────────────────
// USER PROFILE
// One row per applicant (created on first save), plus their qualifications
// and test scores. Name and photo stay on User (User.name / User.image) so
// Auth.js and the rest of the app keep reading them from the same place.
// ─────────────────────────────────────────────────────────────────────────

enum UserTestKind {
  ENGLISH      // IELTS, TOEFL, PTE ...
  STANDARDIZED // GRE, GMAT, SAT ...
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic info
  phone            String?
  nationality      String?
  residenceCountry String?
  residenceCity    String?
  dateOfBirth      DateTime? @db.Date

  // Study preferences
  preferredDestination String?
  preferredStudyLevel  String?
  preferredStartYear   Int?
  preferredStartMonth  Int? // 1 to 12
  subjects             String[]

  // Set when the applicant finishes the last onboarding step
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicQualification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level       String // "Bachelor's degree", "Master's degree" ...
  institution String
  programme   String?
  country     String?
  startYear   Int?
  endYear     Int?
  grade       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserTest {
  id     String       @id @default(uuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind     UserTestKind
  name     String // "IELTS Academic", "GRE" ...
  score    String // free text: bands, sections, totals
  testDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
}

// ─────────────────────────────────────────────────────────────────────────
// COUNTRIES AND UNIVERSITIES (where an applicant studied before)
// Feeds the "country of education" and "university" questions of the eligibility check.
// This is NOT the list of places to study at: those are Institution and School above.
// Edited in the database at any time; prisma/seed-countries.ts only fills in what is missing.
// ─────────────────────────────────────────────────────────────────────────

enum UniversityOwnership {
  PUBLIC
  PRIVATE
}

model Country {
  id        String  @id @default(uuid())
  name      String  @unique // "Nigeria"
  code      String  @unique // ISO alpha-2, "NG"
  region    String? // "West Africa"
  continent String  @default("Africa")
  order     Int     @default(100) // lower first; 100 = alphabetical after the pinned countries
  isActive  Boolean @default(true)

  universities University[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([continent, order])
}

model University {
  id        String              @id @default(uuid())
  countryId String
  name      String
  shortName String? // "UNILAG"
  city      String?
  website   String?
  ownership UniversityOwnership @default(PUBLIC)
  order     Int                 @default(0) // lower first: most visited / best known at the top
  isActive  Boolean             @default(true)

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, name])
  @@index([countryId, order])
}

// ─────────────────────────────────────────────────────────────────────────
// ELIGIBILITY PROFILE
// What a user answered in an eligibility check, kept as one flat { fieldKey: value } object so the
// course search (and later the mobile app) can read it in one query without joining the
// submission tables. The submission itself (ApplicationSubmission + SubmissionValue) stays the
// source of truth; this row is rewritten from it every time the check is saved or finished.
// ─────────────────────────────────────────────────────────────────────────

model EligibilityProfile {
  id            String    @id @default(uuid())
  userId        String
  applicationId String // the eligibility application answered (Study abroad, Visa...)
  answers       Json // { "study_level": "Postgraduate", "subjects": ["Computer Science"], ... }
  completedAt   DateTime? // null while the check is only partly answered

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, applicationId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// DESTINATIONS, CITIES AND VISA TYPES
// The countries people move to, the major cities they settle in, and the visas that can take them
// there. They feed the Accommodation and Visa Application checks of the eligibility flow:
//   Accommodation: destination -> City (with an "Other" choice for a city that is not listed)
//   Visa:          destination -> VisaPurpose ("What do you want to do abroad?") -> VisaType
// The person never has to know visa names: they pick a goal in plain words, then pick from the
// visas of that destination that serve it, each with a short explanation.
// This is separate from Country (where people studied before) and from Institution / School.
// A Destination `name` must match the choices of the "Destination country" question.
// Edited in the database at any time; prisma/seed-destinations.ts only fills in what is missing.
// ─────────────────────────────────────────────────────────────────────────

model Destination {
  id       String  @id @default(uuid())
  name     String  @unique // "United Kingdom"
  code     String  @unique // ISO alpha-2, "GB"
  order    Int     @default(100) // lower first
  isActive Boolean @default(true)

  cities    City[]
  visaTypes VisaType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model City {
  id            String  @id @default(uuid())
  destinationId String
  name          String // "Manchester"
  region        String? // "England", "Ontario", "Bavaria"
  order         Int     @default(100) // lower first: the city most people choose at the top
  isActive      Boolean @default(true)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([destinationId, name])
  @@index([destinationId, isActive, order])
}

// The first question of the visa funnel, in the person's own words.
model VisaPurpose {
  id          String  @id @default(uuid())
  slug        String  @unique // "study", "work", "visit", "family", "business", "not-sure"
  name        String // "Study"
  goalLabel   String // what the person taps: "I want to study abroad"
  description String? // one plain line under it
  emoji       String?
  order       Int     @default(100)
  isActive    Boolean @default(true)

  visaTypes VisaType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One visa of one destination, filed under the purpose it serves. A purpose with no visa in a
// destination is simply not offered there.
model VisaType {
  id            String  @id @default(uuid())
  destinationId String
  purposeId     String
  slug          String // "student", "skilled-worker": unique inside the destination
  name          String // "Student visa"
  summary       String // who it is for, in plain words
  serviceSlug   String? // the page under /services that explains it, "study-visa"
  order         Int     @default(100) // lower first: the most common visa at the top
  isActive      Boolean @default(true)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  purpose     VisaPurpose @relation(fields: [purposeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([destinationId, slug])
  @@index([destinationId, purposeId, isActive, order])
}
// ─────────────────────────────────────────────────────────────────────────
// INTEGRATION TOKENS
// Already exists in the database (created outside Prisma, holds the Zoho CRM
// refresh token). Declared here only so `prisma db push` does not drop it.
// @@map / @map point the model at the existing table and column names.
// ──────────
model IntegrationToken {
  name      String    @id
  token     String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("integration_tokens")
}